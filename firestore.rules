rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /games/{gameId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /gameSessions/{gameId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(gameId)/players/$(request.auth.uid));
      allow write: if false;
    }

    match /giftCatalog/{giftId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /rooms/{roomId} {
      allow read: if isMember(roomId);
      allow write: if false;

      match /players/{uid} {
        allow read: if isMember(roomId);
        allow write: if false;
      }

      match /private/{uid} {
        allow read: if signedIn() &&
          request.auth.uid == uid &&
          isMember(roomId);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read, write: if false;
      }

      match /gifts/{giftId} {
        allow read: if isMember(roomId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow write: if false;
      }
    }
  }
}
