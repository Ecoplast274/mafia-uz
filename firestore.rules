rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      allow read: if isMember(roomId);
      allow write: if false;

      match /players/{uid} {
        allow read: if isMember(roomId);
        allow write: if false;
      }

      match /private/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isMember(roomId);
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if isMember(roomId);
        allow write: if false;
      }
    }
  }
}
